# Copy to .env at the repository root.
# Convex HTTP site URL. The desktop build compiles it into the app for login;
# scripts/convex.mjs derives the matching .convex.cloud URL from it.
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site

# Configure the following ONLY in the selected Convex deployment environment.
# These values are documented here; copying them into .env does not configure Convex.
# TODO_OWNER_ID=personal-owner
# SHOO_OWNER_SUBJECTS={"https://YOUR_DEPLOYMENT.convex.site":"ps_..."}
# AUTH_JWT_ISSUER=https://YOUR_DEPLOYMENT.convex.site
# AUTH_JWT_PRIVATE_JWK=<private JSON from vp run keys:generate>
# AUTH_JWT_PUBLIC_JWKS=<public JSON from vp run keys:generate>
# Optional: the web app's exact https origin. Absent = web login and CORS off.
# WEB_APP_ORIGIN=https://task.shubrt.me
# First backend setup: publish endpoints with AUTH_JWT_ISSUER='', verify JWKS,
# then set the issuer and deploy again to the SAME production backend.
# SHOO_OWNER_SUBJECTS may start as {}. The first desktop login is then rejected
# and its error message shows the exact JSON value to set.
# Keep deployment credentials in a separate ignored .env.convex-target file.
# See docs/development.md for the exact setup sequence.
