# Web server. Copy to .env at the repository root.
# Public Convex client URL, compiled into the browser bundle.
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# Convex HTTP actions URL, used only by the web server.
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site
APP_ORIGIN=https://todo.localhost
# Generate locally using vp run keys:generate. Never commit the result.
AUTH_COOKIE_SECRET=

# Configure the following ONLY in the selected Convex deployment environment.
# These values are documented here; copying them into .env does not configure Convex.
# APP_ALLOWED_ORIGINS=https://todo.localhost,https://YOUR_PRODUCTION_DOMAIN
# TODO_OWNER_ID=personal-owner
# SHOO_OWNER_SUBJECTS={"https://todo.localhost":"VERIFIED_LOCAL_SHOO_SUB","https://YOUR_PRODUCTION_DOMAIN":"VERIFIED_PRODUCTION_SHOO_SUB"}
# AUTH_JWT_ISSUER=https://YOUR_DEPLOYMENT.convex.site
# AUTH_JWT_PRIVATE_JWK=<private JSON from key generator>
# AUTH_JWT_PUBLIC_JWKS=<public JSON from key generator>
# First backend setup: publish endpoints with AUTH_JWT_ISSUER unset, verify JWKS,
# then set the issuer and deploy again to the SAME production backend.
# SHOO_OWNER_SUBJECTS may start as {} for /api/auth/identity, which grants no session.
# Keep deployment credentials in a separate ignored .env.convex-target file.
# See docs/development.md for the exact setup sequence.

# Optional server logging. Console works without Axiom.
# AXIOM_DATASET=todo
# AXIOM_TOKEN=
