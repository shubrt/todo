<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/habit_row" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="top">
  <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="○" android:textColor="#7E9266" android:textSize="20sp" android:importantForAccessibility="no" />
  <TextView android:id="@+id/habit_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#343B2E" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="3dp" />
</LinearLayout>
